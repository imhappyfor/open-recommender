{
  "manifest_version": 3,
  "name": "ORF Gateway",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Site-specific ORF login approved in your Mac app. No profile uploads.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
    "js": ["content.js"], "all_frames": false, "run_at": "document_start"}],
  "action": {"default_title": "ORF Gateway", "default_popup": "popup.html"}
}
